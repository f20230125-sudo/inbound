# M1 is always offline. No API keys or network transports are used.
# Optional writable root, on D: only; default is the repository's .local/.
# INBOUND_DATA_ROOT=D:/inbound-data
# Optional comma-separated exact mailboxes; empty disables personal contacts.
# INBOUND_PERSONAL_CONTACTS=noor@contacts.demo.invalid,ishan@contacts.demo.invalid
